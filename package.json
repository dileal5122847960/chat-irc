{
  "name": "chamuflac",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:app": "vite --config vite.app.config.js",
    "build:app": "vite build --config vite.app.config.js",
    "android:sync": "npm run build:app && cap sync android",
    "build:desktop": "vite build --config vite.desktop.config.js",
    "dist:windows": "npm run build:desktop && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.4.6"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@supabase/supabase-js": "^2.119.2"
  },
  "androidVersion": "1.0.6",
  "windowsVersion": "1.0.2"
}
