{
  "appId": "com.chamuflac.app",
  "appName": "ChamuFlac",
  "webDir": "dist-app",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#111318",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_chamuflac",
      "iconColor": "#E11D48"
    }
  }
}
